// Запит-доказ завантаження provenance:
MATCH (h)-[r]->(t) WHERE r.doc_id IS NOT NULL AND r.model IS NOT NULL RETURN type(r) AS rel, count(r) AS cnt, round(avg(r.confidence), 3) AS avgConf ORDER BY cnt DESC;
