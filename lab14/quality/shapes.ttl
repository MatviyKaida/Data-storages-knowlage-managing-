@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skm: <http://lnu.edu.ua/sports-km#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

skm:AthleteShape a sh:NodeShape ;
  sh:targetClass skm:Athlete ;
  sh:property [ sh:path skm:entityCode ; sh:minCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path skm:name ; sh:minCount 1 ; sh:datatype xsd:string ] .

skm:LoadRecoveryMetricShape a sh:NodeShape ;
  sh:targetClass skm:LoadRecoveryMetric ;
  sh:property [
    sh:path skm:acwrValue ; sh:minCount 1 ; sh:datatype xsd:decimal ;
    sh:minInclusive 0.50 ; sh:maxInclusive 2.50 ;
    sh:message "ACWR має бути в допустимому фізіологічному діапазоні [0.50, 2.50]"
  ] ;
  sh:property [
    sh:path skm:readinessScorePct ; sh:minInclusive 0 ; sh:maxInclusive 100
  ] .

skm:LabTestShape a sh:NodeShape ;
  sh:targetClass skm:LabTest ;
  sh:property [ sh:path skm:creatineKinaseUL ; sh:minInclusive 0 ] ;
  sh:property [ sh:path skm:lsiSymmetryPct ; sh:minInclusive 0 ; sh:maxInclusive 100 ] .
