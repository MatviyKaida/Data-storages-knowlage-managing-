{
  "openapi": "3.0.2",
  "info": {
    "title": "Sports Knowledge Hub Hybrid RAG API",
    "description": "Гібридний RAG + GraphRAG API з автентифікацією, ролями sensitivity та лімітом запитів.",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/sources/{source_id}": {
      "get": {
        "summary": "Get Source",
        "operationId": "get_source_sources__source_id__get",
        "parameters": [
          {
            "required": true,
            "schema": {
              "title": "Source Id",
              "type": "string"
            },
            "name": "source_id",
            "in": "path"
          },
          {
            "required": false,
            "schema": {
              "title": "X-Api-Key",
              "type": "string"
            },
            "name": "x-api-key",
            "in": "header"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/ask": {
      "post": {
        "summary": "Ask",
        "operationId": "ask_ask_post",
        "parameters": [
          {
            "required": false,
            "schema": {
              "title": "X-Api-Key",
              "type": "string"
            },
            "name": "x-api-key",
            "in": "header"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AskRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AskResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AskRequest": {
        "title": "AskRequest",
        "required": [
          "question"
        ],
        "type": "object",
        "properties": {
          "question": {
            "title": "Question",
            "maxLength": 500,
            "minLength": 3,
            "type": "string",
            "description": "Запитання користувача"
          },
          "top_k": {
            "title": "Top K",
            "maximum": 10.0,
            "minimum": 1.0,
            "type": "integer",
            "description": "Кількість фрагментів контексту",
            "default": 5
          },
          "use_graph": {
            "title": "Use Graph",
            "type": "boolean",
            "description": "Додавати підграф із графа знань",
            "default": true
          }
        }
      },
      "AskResponse": {
        "title": "AskResponse",
        "required": [
          "role",
          "answer",
          "sources",
          "citation_valid",
          "latency_ms"
        ],
        "type": "object",
        "properties": {
          "role": {
            "title": "Role",
            "type": "string"
          },
          "answer": {
            "title": "Answer",
            "type": "string"
          },
          "sources": {
            "title": "Sources",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "citation_valid": {
            "title": "Citation Valid",
            "type": "boolean"
          },
          "latency_ms": {
            "title": "Latency Ms",
            "type": "number"
          }
        }
      },
      "HTTPValidationError": {
        "title": "HTTPValidationError",
        "type": "object",
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            }
          }
        }
      },
      "ValidationError": {
        "title": "ValidationError",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "type": "object",
        "properties": {
          "loc": {
            "title": "Location",
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            }
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        }
      }
    }
  }
}